# Server-side only. Never expose this key through NEXT_PUBLIC_ variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Python API and local PostgreSQL (never use development defaults in production)
ENVIRONMENT=development
POSTGRES_USER=examgen
POSTGRES_PASSWORD=replace_with_a_local_secret
POSTGRES_DB=examgen
DATABASE_URL=postgresql+psycopg://examgen:replace_with_a_local_secret@db:5432/examgen
AUTH_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
ACCESS_TOKEN_TTL_MINUTES=15

# Academic document ingestion (25 MiB default; private server-side storage)
DOCUMENT_STORAGE_PATH=./data/documents
MAX_DOCUMENT_UPLOAD_BYTES=20000000

# Comma-separated browser origins permitted to call the Python API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Document processing security and bounded resource controls
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
DOCUMENT_JOB_LEASE_SECONDS=3600
MAX_PDF_PAGES=100
MAX_PDF_PAGE_PIXELS=20000000
OCR_PAGE_TIMEOUT_SECONDS=15
MAX_EXTRACTED_CHARACTERS=10000000
MAX_OFFICE_ARCHIVE_RATIO=100

# Private document object storage. Keep local for development; use S3 for managed deployments.
DOCUMENT_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=af-south-1
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# AES256 (default) or aws:kms requires a configured KMS on the S3-compatible provider.
# Leave empty only for local MinIO development without an SSE/KMS service.
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=AES256

# Optional local MinIO profile (development only; bind ports to localhost).
MINIO_ROOT_USER=examgen-local-minio
MINIO_ROOT_PASSWORD=replace_with_a_long_random_local_secret
